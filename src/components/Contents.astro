---
import Icon from './Icon.astro';
import { contents, links } from '../data/site';
import { platforms } from '../data/platforms';

const urlOf = (key: string) => links.find((l) => l.key === key)?.url;
---

<section id="contents" class="px-4 py-16 sm:px-6 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
      <div>
        <h2 class="sec-title">CONTENTS</h2>
        <p class="sec-sub">どんな発信をしているか</p>
      </div>
      <p class="max-w-md text-sm text-sub">
        テーマごとに、いちばん届けやすい場所で発信しています。アイコンから各SNSへ飛べます。
      </p>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        contents.map((c, i) => (
          <li
            data-reveal
            style={`--d:${i * 0.08}s`}
            class="group flex flex-col rounded-[26px] border border-line bg-white p-6 transition-[transform,box-shadow] duration-300 hover:-translate-y-1.5 hover:shadow-[0_24px_50px_-28px_rgba(46,42,36,.35)]"
          >
            <span class="font-en grid size-12 place-items-center rounded-2xl bg-yellow text-lg font-bold">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="font-en mt-6 text-xs font-semibold tracking-[0.14em] text-mustard">{c.en}</p>
            <h3 class="mt-1 text-lg font-bold tracking-[0.08em]">{c.title}</h3>
            <p class="mt-3 text-sm leading-[1.85] text-ink/80">{c.body}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {c.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
            <div class="grow" />
            <div class="mt-6 flex items-center gap-2 border-t border-dashed border-line pt-4">
              <span class="mr-1 text-[11px] font-bold tracking-[0.1em] text-sub">発信先</span>
              {c.platforms.map((p) => (
                <a
                  href={urlOf(p)}
                  target="_blank"
                  rel="noopener"
                  title={platforms[p].name}
                  aria-label={platforms[p].name}
                  class="grid size-9 place-items-center rounded-full bg-paper transition-colors hover:bg-yellow-soft"
                >
                  <Icon name={p} size={16} brand />
                </a>
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
