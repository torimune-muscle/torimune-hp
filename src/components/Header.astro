---
import Avatar from './Avatar.astro';
import { profile } from '../data/site';

const nav = [
  { href: '#about', label: 'ABOUT' },
  { href: '#contents', label: 'CONTENTS' },
  { href: '#links', label: 'LINKS' },
];
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex items-start justify-between p-4 sm:p-6">
  <a
    href="#top"
    class="pointer-events-auto flex flex-col items-center gap-1 transition-transform hover:-rotate-3"
    aria-label={`${profile.name} トップへ`}
  >
    <Avatar size={52} class="shadow-[0_4px_14px_rgba(46,42,36,.12)] ring-3 ring-white" />
    <span class="font-en text-[10px] font-semibold tracking-[0.14em] max-sm:hidden">{profile.nameEn}</span>
  </a>

  <nav
    class="pointer-events-auto flex items-center gap-1 rounded-full bg-white/85 p-1.5 shadow-[0_6px_24px_rgba(46,42,36,.08)] backdrop-blur-md"
    aria-label="メインメニュー"
  >
    {
      nav.map((n) => (
        <a
          href={n.href}
          class="font-en rounded-full px-3 py-1.5 text-[13px] font-medium tracking-[0.08em] transition-colors hover:bg-paper max-sm:hidden sm:px-4"
        >
          {n.label}
        </a>
      ))
    }
    <a
      href="#links"
      class="font-en rounded-full px-3 py-1.5 text-[13px] font-medium tracking-[0.08em] transition-colors hover:bg-paper sm:hidden"
    >
      LINKS
    </a>
    <a
      href="#contact"
      class="group font-en flex items-center gap-2 rounded-full bg-yellow px-4 py-1.5 text-[13px] font-bold tracking-[0.08em] transition-colors hover:bg-yellow-deep"
    >
      CONTACT
      <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </a>
  </nav>
</header>
